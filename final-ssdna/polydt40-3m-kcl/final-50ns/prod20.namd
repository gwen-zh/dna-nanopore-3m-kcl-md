structure system.psf
coordinates system.pdb
outputName prod20
bincoordinates eq3.restart.coor
binvelocities eq3.restart.vel
extendedSystem eq3.restart.xsc
source common.namd

langevin on
langevinTemp 293
langevinDamping 1.0
langevinHydrogen off
langevinPiston on
langevinPistonTarget 1.01325
langevinPistonTemp 293
langevinPistonPeriod 200
langevinPistonDecay 100
useGroupPressure yes
useFlexibleCell no

constraints off
run 10000000
