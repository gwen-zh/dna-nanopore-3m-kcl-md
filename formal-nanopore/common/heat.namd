source system_settings.namd
structure system.psf
coordinates system.pdb
outputName heat
bincoordinates min.coor
extendedSystem min.xsc
temperature 50
source ../../common/common.namd

constraints on
consref restraints_strong.pdb
conskfile restraints_strong.pdb
conskcol B
constraintScaling 1.0
reassignFreq 1000
reassignTemp 50
reassignIncr 1.0
reassignHold 293
reinitvels 50
run 250000
