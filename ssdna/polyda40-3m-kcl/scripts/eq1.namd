structure ../scripts/input/system.psf
coordinates ../scripts/input/system.pdb
outputName eq1
bincoordinates heat.restart.coor
binvelocities heat.restart.vel
extendedSystem heat.restart.xsc
source ../scripts/common.namd

langevin on
langevinTemp 293
langevinDamping 1.0
langevinHydrogen off
langevinPiston on
langevinPistonTarget 1.01325
langevinPistonTemp 293
langevinPistonPeriod 200
langevinPistonDecay 100
useGroupPressure yes
useFlexibleCell no

constraints on
consref ../scripts/input/restraints.pdb
conskfile ../scripts/input/restraints.pdb
conskcol B
constraintScaling 0.5
run 1000000
