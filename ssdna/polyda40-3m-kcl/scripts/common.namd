paraTypeCharmm on
parameters /opt/charmm/toppar/par_all36_na.prm
parameters ../scripts/input/water_ions_namd.prm

wrapAll on
wrapNearest on
PME on
PMEGridSizeX 72
PMEGridSizeY 72
PMEGridSizeZ 180
switching on
switchDist 10.0
cutoff 12.0
pairlistdist 14.0
exclude scaled1-4
1-4scaling 1.0
rigidBonds all
timestep 2.0
nonbondedFreq 1
fullElectFrequency 2
stepsPerCycle 20

outputEnergies 1000
outputTiming 1000
restartFreq 10000
xstFreq 10000
dcdFreq 5000
binaryOutput yes
binaryRestart yes
