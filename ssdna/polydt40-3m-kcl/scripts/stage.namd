# Unrestrained NPT continuation of the validated dT40 3 M KCl trajectory.
cd $env(DT_BOX)
structure system.psf
coordinates system.pdb
bincoordinates "$env(INPUT_PREFIX).coor"
binvelocities "$env(INPUT_PREFIX).vel"
extendedSystem "$env(INPUT_PREFIX).xsc"
outputName $env(OUTPUT_PREFIX)
firsttimestep $env(START_STEP)
source $env(CODE_DIR)/common.namd
seed $env(MD_SEED)

constraints off
langevin on
langevinTemp 293
langevinDamping 1.0
langevinHydrogen off
langevinPiston on
langevinPistonTarget 1.01325
langevinPistonTemp 293
langevinPistonPeriod 200
langevinPistonDecay 100
useGroupPressure yes
useFlexibleCell no
run $env(RUN_STEPS)
