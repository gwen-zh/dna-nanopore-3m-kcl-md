structure system.psf
coordinates system.pdb
outputName heat
bincoordinates min.restart.coor
extendedSystem min.restart.xsc
temperature 50
source common.namd

constraints on
consref restraints.pdb
conskfile restraints.pdb
conskcol B
constraintScaling 1.0

# 250 increments at 1000-step intervals: 50 K -> 293 K over 0.5 ns.
reassignFreq 1000
reassignTemp 50
reassignIncr 1.0
reassignHold 293
reinitvels 50
run 250000
