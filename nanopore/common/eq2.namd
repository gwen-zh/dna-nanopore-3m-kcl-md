if {[info exists env(SYSTEM_DIR)]} { cd $env(SYSTEM_DIR) }
source system_settings.namd
structure system.psf
coordinates system.pdb
outputName eq2
bincoordinates eq1.coor
binvelocities eq1.vel
extendedSystem eq1.xsc
source ../../common/common.namd

langevin on
langevinTemp 293
langevinDamping 1.0
langevinHydrogen off
constraints on
consref restraints_strong.pdb
conskfile restraints_strong.pdb
conskcol B
constraintScaling 0.2
run 500000
