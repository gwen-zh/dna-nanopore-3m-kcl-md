paraTypeCharmm on
# The inherited 7AHL PSF contains legacy CHARMM22 types (including HB).
# Keep the same fallback-before-C36 ordering as its original working inputs.
if {[info exists legacy_protein_parameters] && $legacy_protein_parameters} {
    parameters /opt/charmm/toppar/par_all22_prot.prm
}
parameters /opt/charmm/toppar/par_all36m_prot.prm
parameters /opt/charmm/toppar/par_all36_lipid.prm
parameters /opt/charmm/toppar/par_all36_na.prm
parameters ../water_ions_namd.prm

cellBasisVector1 $cell_x 0.0 0.0
cellBasisVector2 0.0 $cell_y 0.0
cellBasisVector3 0.0 0.0 $cell_z
cellOrigin 0.0 0.0 $origin_z
wrapAll on
wrapNearest on

PME on
PMEGridSizeX $grid_x
PMEGridSizeY $grid_y
PMEGridSizeZ $grid_z
switching on
switchDist 10.0
cutoff 12.0
pairlistdist 14.0
exclude scaled1-4
1-4scaling 1.0
rigidBonds all
timestep 2.0
nonbondedFreq 1
fullElectFrequency 2
stepsPerCycle 20

outputEnergies 1000
outputTiming 1000
restartFreq 25000
xstFreq 25000
dcdFreq 25000
binaryOutput yes
binaryRestart yes
